<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Android blocks cleartext HTTP by default from targetSdk 28, which is correct
  and stays that way for release — the real deployment is HTTPS behind Cloudflare Access.

  This permits it for the loopback addresses only, so a local mock of `/api/recipes` can be
  pointed at during development. `10.0.2.2` is the emulator's alias for the host's loopback.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
