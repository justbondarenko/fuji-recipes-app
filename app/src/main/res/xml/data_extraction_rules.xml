<?xml version="1.0" encoding="utf-8"?>
<!--
  The app opts out of backup entirely (`allowBackup="false"`), because the Access service
  token lives in app-private DataStore — steering/architecture.md §5.

  These rules exist so the opt-out is explicit on both transports rather than inherited,
  and so a future partial opt-in has to be a deliberate edit here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
