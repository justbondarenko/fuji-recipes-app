    <string name="export_format_json_hint">Every selected recipe in a single file. The easiest to keep and to read back in.</string>
    <string name="export_format_zip">ZIP of JSON files</string>
    <string name="export_format_zip_hint">One file per recipe inside an archive. Better when you want to pick individual recipes out later.</string>
