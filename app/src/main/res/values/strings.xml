    <!-- Export — FEAT-008 -->
    <string name="export_title">Export</string>
    <string name="export_subtitle">Save your recipes to a file and share it anywhere</string>
    <string name="export_intro">Builds the file on this phone. The share sheet takes it from there — Files, Drive, a message, anything installed. This is how a library gets backed up or moved to another device.</string>
    <string name="export_loading">Loading your library…</string>
    <string name="export_empty_title">Nothing to export yet</string>
    <string name="export_empty_body">Export saves your recipes to a file you can keep or move to another phone. Make your first one and it will be waiting here.</string>
