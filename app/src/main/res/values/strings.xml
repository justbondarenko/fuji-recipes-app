    <string name="error_access_unconfigured_title">The server is not ready</string>
    <string name="error_access_unconfigured_body">The deployment has no Access gate configured, so it is refusing to serve the library. This is a server setting, not a problem with your token.</string>

    <string name="error_storage_title">The library is temporarily unreachable</string>
