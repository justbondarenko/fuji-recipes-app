<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required from FEAT-001: the server owns the library (steering/architecture.md §4).
      This supersedes PRD.md §4.1, which described a local-only app with no network.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      FEAT-006: a partial wake lock is held for the duration of a write and no longer. Writes
      take seconds, and a screen timeout with doze arriving mid-transfer is a bad way to leave
      a slot half-written (`PRD.md` §8.4).
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      FEAT-005. Declared required: a device without USB host cannot do the thing the app
      exists for (`steering/tech-stack.md` §4).
    -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <application
        android:name=".FujiRecipesApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FujiRecipes.Starting">

        <!--
          `singleTop`: a camera plugged in while the app is open must arrive at `onNewIntent`
          on the running activity, rather than launching a second copy on top of the one
          holding the connection.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FujiRecipes.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The feature that justifies going native (`PRD.md` §8.2): plug the camera in and
              the app opens already connected. Launching this way grants USB permission
              implicitly for that connection, so no dialog appears.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!--
          USB lifecycle receiver for device detachment and attachment broadcasts.
        -->
        <receiver
            android:name=".camera.UsbReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>

        <!--
          FEAT-008: exports are shared as content:// URIs so the OS share sheet can hand them
          to Files, Drive, mail or anything else installed.

          `exported="false"` with `grantUriPermissions="true"` is the pair that matters: no app
          can reach this provider on its own, and a receiving app only gets a one-shot read
          grant for the single file the user chose to share. `@xml/file_paths` scopes it to one
          cache subdirectory.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
